rules_version = '2';
// Each signed-in user can read and write only their own data (profiles, watch progress, My List). Nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt']);
      allow delete: if false;

      match /profiles/{pid} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.kids is bool;
        allow delete: if owner(uid);

        match /progress/{itemId} { allow read, write: if owner(uid); }
        match /list/{itemId} { allow read, write: if owner(uid); }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
